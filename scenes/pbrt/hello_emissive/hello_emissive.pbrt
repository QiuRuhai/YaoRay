# YaoRay PBRT smoke-test scene
#
# A small lit room demonstrating: trianglemesh geometry, matte/diffuse
# materials, an emissive area light, and the multi-threaded path tracer.
# This is the baseline scene that proves the post-M0 pipeline produces a
# non-trivial image end to end.

LookAt 0 1 3.5  0 0.5 0  0 1 0
Camera "perspective" "float fov" [45]
Sampler "independent" "integer pixelsamples" [64]
Integrator "path" "integer maxdepth" [5]
Film "rgb"
    "integer xresolution" [256]
    "integer yresolution" [256]
    "string filename" ["out/hello_emissive.png"]

WorldBegin

# --- materials -------------------------------------------------------------
MakeNamedMaterial "white"
    "string type" ["diffuse"]
    "rgb reflectance" [0.72 0.72 0.72]

MakeNamedMaterial "red"
    "string type" ["diffuse"]
    "rgb reflectance" [0.78 0.16 0.16]

MakeNamedMaterial "green"
    "string type" ["diffuse"]
    "rgb reflectance" [0.16 0.62 0.20]

# --- floor (two triangles) -------------------------------------------------
AttributeBegin
NamedMaterial "white"
Shape "trianglemesh"
    "point3 P" [
        -1.5 0.0 -1.5
         1.5 0.0 -1.5
         1.5 0.0  1.5
        -1.5 0.0  1.5
    ]
    "integer indices" [0 1 2  0 2 3]
AttributeEnd

# --- left wall (red) -------------------------------------------------------
AttributeBegin
NamedMaterial "red"
Shape "trianglemesh"
    "point3 P" [
        -1.5 0.0 -1.5
        -1.5 0.0  1.5
        -1.5 2.0  1.5
        -1.5 2.0 -1.5
    ]
    "integer indices" [0 1 2  0 2 3]
AttributeEnd

# --- right wall (green) ----------------------------------------------------
AttributeBegin
NamedMaterial "green"
Shape "trianglemesh"
    "point3 P" [
         1.5 0.0 -1.5
         1.5 2.0 -1.5
         1.5 2.0  1.5
         1.5 0.0  1.5
    ]
    "integer indices" [0 1 2  0 2 3]
AttributeEnd

# --- back wall -------------------------------------------------------------
AttributeBegin
NamedMaterial "white"
Shape "trianglemesh"
    "point3 P" [
        -1.5 0.0 -1.5
        -1.5 2.0 -1.5
         1.5 2.0 -1.5
         1.5 0.0 -1.5
    ]
    "integer indices" [0 1 2  0 2 3]
AttributeEnd

# --- ceiling ---------------------------------------------------------------
AttributeBegin
NamedMaterial "white"
Shape "trianglemesh"
    "point3 P" [
        -1.5 2.0 -1.5
        -1.5 2.0  1.5
         1.5 2.0  1.5
         1.5 2.0 -1.5
    ]
    "integer indices" [0 1 2  0 2 3]
AttributeEnd

# --- ceiling area light (small bright quad) --------------------------------
AttributeBegin
AreaLightSource "diffuse" "rgb L" [1.0 0.95 0.85]
Shape "trianglemesh"
    "point3 P" [
        -0.35 1.99 -0.35
         0.35 1.99 -0.35
         0.35 1.99  0.35
        -0.35 1.99  0.35
    ]
    "integer indices" [0 1 2  0 2 3]
AttributeEnd

# --- short pedestal in the middle of the room ------------------------------
AttributeBegin
NamedMaterial "white"
Translate 0 0 0
Shape "trianglemesh"
    "point3 P" [
        -0.3 0.0 -0.3
         0.3 0.0 -0.3
         0.3 0.6 -0.3
        -0.3 0.6 -0.3
        -0.3 0.0  0.3
         0.3 0.0  0.3
         0.3 0.6  0.3
        -0.3 0.6  0.3
    ]
    "integer indices" [
        0 1 2  0 2 3
        4 6 5  4 7 6
        3 2 6  3 6 7
        0 4 5  0 5 1
        1 5 6  1 6 2
        0 3 7  0 7 4
    ]
AttributeEnd

WorldEnd
